# Copy is written by ./scripts/setup.sh. Locally the agent reads this file; `agents-cli
# deploy` copies every line into the deployed agent's environment, so never put a
# secret here: use Secret Manager and `agents-cli deploy --secrets ENV=SECRET`.

# Gemini via Agent Platform (Vertex AI)
GOOGLE_GENAI_USE_ENTERPRISE=true
GOOGLE_CLOUD_PROJECT=your-project-id
GOOGLE_CLOUD_LOCATION=global

# MCP servers (Cloud Run URLs, written by setup.sh). Unset = local servers on 8081-8083.
HRIS_MCP_URL=https://hris-mcp-xxxxxxxxxx-ew.a.run.app
TICKETING_MCP_URL=https://ticketing-mcp-xxxxxxxxxx-ew.a.run.app
COMPENSATION_MCP_URL=https://compensation-mcp-xxxxxxxxxx-ew.a.run.app

# Demo mode: employee the agent acts for when the user id is not an email
# (agents-cli run always sends "cli-user"). Remove it in production.
DEMO_USER_EMAIL=deniz.kaya@kuzeylabs.example

# Telemetry that Online Monitors score (step 6). They put prompts and answers in Cloud
# Logging and Cloud Trace; the workshop data is fictional.
OTEL_SEMCONV_STABILITY_OPT_IN=gen_ai_latest_experimental
OTEL_INSTRUMENTATION_GENAI_CAPTURE_MESSAGE_CONTENT=EVENT_ONLY
ADK_CAPTURE_MESSAGE_CONTENT_IN_SPANS=true

# Optional (step 4): Agent Identity Auth Manager provider for Google Calendar.
# CALENDAR_AUTH_PROVIDER=projects/PROJECT_ID/locations/europe-west1/authProviders/calendar-3lo
